# Neon Direct Connection (for drizzle-kit migrations)
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# Neon Connection Pooler (for runtime queries)
DATABASE_URL_POOLER=postgresql://user:password@endpoint-pooler.neon.tech/neondb?sslmode=require

# Better Auth Configuration
# In production, set BETTER_AUTH_URL to your deployed domain (e.g. https://your-site.vercel.app or https://yourdomain.com)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Optional: comma-separated list of additional trusted origins (e.g. preview domains or multiple domains)
BETTER_AUTH_TRUSTED_ORIGINS=

# Neon Direct Connection (for drizzle-kit migrations)
DATABASE_URL_UNPOOLED=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# Neon Object Storage (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
STORAGE_BUCKET=assets
