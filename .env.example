# Neon Direct Connection (for drizzle-kit migrations)
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# Neon Connection Pooler (for runtime queries)
DATABASE_URL_POOLER=postgresql://user:password@endpoint-pooler.neon.tech/neondb?sslmode=require

# Better Auth Configuration
# In production, set BETTER_AUTH_URL to your deployed domain (e.g. https://your-site.vercel.app or https://yourdomain.com)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Optional: comma-separated list of additional trusted origins (e.g. preview domains or multiple domains)
BETTER_AUTH_TRUSTED_ORIGINS=

# Neon Direct Connection (for drizzle-kit migrations)
DATABASE_URL_UNPOOLED=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# Neon Object Storage (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
STORAGE_BUCKET=assets

# ==============================================================================
# SMS & OTP Gateway Configuration (Nepal)
# ==============================================================================
# Provider options: nepalotp (recommended, https://nepalotp.com), sparrow, aakash, mock
SMS_PROVIDER=nepalotp

# NepalOTP Integration (https://nepalotp.com/code-examples#nextjs)
# Ultra-fast direct carrier routing for Nepal (NTC & Ncell) with < 1.4s delivery
# 1. Sign up / login at https://nepalotp.com
# 2. Get your API Key from the dashboard (e.g. npot_live_... or npot_sandbox_...)
NEPALOTP_API_KEY=
# Base API URL (default: https://nepalotp.com/api/v1)
NEPALOTP_BASE_URL=https://nepalotp.com/api/v1
# Registered Sender ID from your NepalOTP dashboard (default: Mezmani)
NEPALOTP_SENDER_ID=Mezmani
# OTP validity duration in seconds (default: 300 seconds / 5 minutes)
NEPALOTP_OTP_TTL=300

# NepalOTP Real-Time Webhooks (https://nepalotp.com/docs#webhooks)
# Register this webhook URL in your NepalOTP dashboard:
#   Production:  https://yourdomain.com/api/webhooks/nepalotp
#   Local/Dev:   https://your-ngrok-or-tunnel.ngrok-free.app/api/webhooks/nepalotp
# Webhook signing secret from your NepalOTP dashboard (Webhooks -> Signing Secret)
NEPALOTP_WEBHOOK_SECRET=
# Webhook timestamp tolerance in seconds to prevent replay attacks (default: 300)
NEPALOTP_WEBHOOK_TOLERANCE_SECONDS=300

# Alternative: Sparrow SMS (Nepal)
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=Mezmani

# Alternative: Aakash SMS (Nepal)
AAKASH_SMS_AUTH_TOKEN=

# eSewa Payment Gateway (Nepal)
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
ESEWA_LIVE=false

