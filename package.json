{
  "name": "Mezmani",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000 --host",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts",
    "db:clean": "bun run src/db/clean.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/server/finance/accounting-validation.test.ts src/server/scheduler/campaign-scheduler.test.ts src/lib/campaign-timezone.test.ts src/server/auth/permissions.test.ts",
    "test:campaigns": "node --import tsx --test src/server/scheduler/campaign-scheduler.test.ts",
    "demo:nepalotp": "bun run src/server/otp/demo-nepalotp.ts",
    "analyze": "ANALYZE=true vite build"
  },
